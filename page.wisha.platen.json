{
	"app-id": "page.wisha.platen",
	"runtime": "org.gnome.Platform",
	"runtime-version": "50",
	"sdk": "org.gnome.Sdk",
	"sdk-extensions": [
		"org.freedesktop.Sdk.Extension.rust-stable"
	],
	"command": "platen",
	"finish-args": [
		"--socket=wayland",
		"--socket=fallback-x11",
		"--device=dri",
		"--share=network",
		"--share=ipc",
		"--filesystem=~/.cache/platen-paste-files/:create",
		"--filesystem=~/.local/share/onlyoffice/desktopeditors/recover/:ro",
		"--filesystem=~/.var/app/org.onlyoffice.desktopeditors/data/onlyoffice/desktopeditors/recover/:ro"
	],
	"build-options": {
		"append-path": "/usr/lib/sdk/rust-stable/bin",
		"env": {
			"CARGO_NET_OFFLINE": "true"
		}
	},
	"modules": [
		{
			"name": "platen",
			"builddir": true,
			"buildsystem": "meson",
			"sources": [
				{
					"type": "git",
					"url": "https://tangled.org/wisha.page/platen",
					"tag": "v0.2.0-release-1",
					"commit": "f074507443abb46e0c5779d5c4e985e483efae97"
				},
				"cargo-sources.json",
				{
					"type": "shell",
					"commands": [
						"mkdir -p .cargo",
						"cp -vf cargo/config .cargo/config.toml"
					]
				}
			]
		}
	]
}

